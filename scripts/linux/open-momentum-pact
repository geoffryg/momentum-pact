#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
data_file="$repo_dir/momentum_pact/data/accountability.json"
window_title='Momentum Pact'

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if hyprctl clients -j 2>/dev/null | jq -e --arg title "$window_title" \
    'any(.[]; .title == $title)' >/dev/null 2>&1; then
    hyprctl dispatch focuswindow 'title:^(Momentum Pact)$' >/dev/null
    exit 0
  fi

fi

cd "$repo_dir"
if command -v setsid >/dev/null 2>&1; then
  setsid --fork python3 -m momentum_pact.app --data "$data_file" </dev/null >/dev/null 2>&1
else
  nohup python3 -m momentum_pact.app --data "$data_file" </dev/null >/dev/null 2>&1 &
fi
